                    </div>
                    <div>
                        <div>
                            <picture>
                                <source srcset="https://www.foroom.ru/_images/about/11.webp" type="image/webp"/>
                                <img src="https://www.foroom.ru/_images/about/11.png" alt="Наличие свободного доступа к подоконнику"/>
