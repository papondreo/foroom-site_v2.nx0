                    </div>
                    <div>
                        <div>
                            <picture>
                                <source srcset="https://www.foroom.ru/_images/about/9.webp" type="image/webp"/>
                                <img src="https://www.foroom.ru/_images/about/9.png" alt="Скрытие инженерных коммуникаций"/>
