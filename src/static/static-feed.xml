                        </div>
                    </div>
                    <div>
                        <div>
                            <picture>
                                <source srcset="https://www.foroom.ru/_images/about/13.webp" type="image/webp"/>
                                <img src="https://www.foroom.ru/_images/about/13.png" alt="Большой ассортимент"/>
