{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "nuxt-ts",
    "build": "nuxt build",
    "start": "nuxt start --max_old_space_size=8192",
    "buildandstart": "NODE_ENV=production nuxt build && NODE_ENV=production nuxt start",
    "test:unit": "vue-cli-service test:unit",
    "test:e2e": "nuxt-ts | vue-cli-service test:e2e --url http://localhost:3000",
    "lint": "vue-cli-service lint",
    "prettier": "prettier --write *.config.{js,ts} src/**/*.{js,ts,vue}",
    "generate": "nuxt-ts generate",
    "prepare": "husky install"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS -g './commitlint.js'"
    }
  },
  "dependencies": {
    "@bchteam/vue-jivosite": "^1.0.0",
    "@nuxt/typescript-runtime": "^0.4.10",
    "@nuxt/ui": "^0.4.1",
    "@nuxtjs/auth-next": "5.0.0-1648802546.c9880dc",
    "@nuxtjs/axios": "^5.13.6",
    "@nuxtjs/eslint-config": "^11.0.0",
    "@nuxtjs/eslint-module": "^3.1.0",
    "@nuxtjs/font-awesome": "^1.0.4",
    "@nuxtjs/proxy": "^2.1.0",
    "@nuxtjs/redirect-module": "^0.3.1",
    "@nuxtjs/robots": "^3.0.0",
    "@nuxtjs/sitemap": "^2.4.0",
    "@nuxtjs/style-resources": "^1.2.1",
    "@rkaliev/nuxtjs-yandex-metrika": "^1.3.0",
    "bootstrap": "^5.2.1",
    "cookie-universal-nuxt": "^2.2.2",
    "dotenv": "^16.3.1",
    "eslint-plugin-nuxt": "^4.0.0",
    "geolib": "^3.3.3",
    "hamburgers": "^1.2.1",
    "nuxt": "^2.14.4",
    "nuxt-mailru-counter": "^1.0.0",
    "nuxt-property-decorator": "^2.9.1",
    "nuxt-vk-rtrg": "^0.0.5",
    "register-service-worker": "^1.7.1",
    "ts-node": "^9.0.0",
    "v-lazy-image": "^2.1.1",
    "v-mask": "^2.3.0",
    "vue-class-component": "^7.2.6",
    "vue-cool-lightbox": "^2.7.5",
    "vue-directive-tooltip": "^1.6.3",
    "vue-lazyload": "^3.0.0-rc.2",
    "vue-loader": "15.0.1",
    "vue-multiselect": "^2.1.7",
    "vue-notification": "^1.3.20",
    "vue-notifikation": "^1.1.0",
    "vue-property-decorator": "^9.0.0",
    "vue-resource": "^1.5.1",
    "vue-silentbox": "^3.0.4",
    "vue-yandex-maps": "^0.11.13",
    "webpack": "4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@nuxt/typescript-build": "^1.0.3",
    "@types/jest": "^24.9.1",
    "@typescript-eslint/eslint-plugin": "^2.34.0",
    "@typescript-eslint/parser": "^2.34.0",
    "@vue/cli-plugin-babel": "~4.5.4",
    "@vue/cli-plugin-e2e-cypress": "~4.5.4",
    "@vue/cli-plugin-eslint": "~4.5.4",
    "@vue/cli-plugin-typescript": "~4.5.4",
    "@vue/cli-plugin-unit-jest": "~4.5.4",
    "@vue/cli-service": "~4.5.4",
    "@vue/eslint-config-prettier": "^6.0.0",
    "@vue/eslint-config-typescript": "^5.1.0",
    "@vue/test-utils": "^1.0.5",
    "css-loader": "^5.0.0",
    "eslint": "^6.8.0",
    "eslint-plugin-prettier": "^3.1.4",
    "eslint-plugin-vue": "^6.2.2",
    "husky": "^8.0.0",
    "lint-staged": "^10.2.13",
    "node-sass": "^4.14.1",
    "postcss": "^8.1.10",
    "postcss-import": "^13.0.0",
    "postcss-loader": "^4.1.0",
    "postcss-url": "^10.1.1",
    "prettier": "^2.7.1",
    "sass-loader": "8.0.2",
    "typescript": "~4.0.2"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "vue-cli-service lint",
      "git add"
    ]
  }
}
